# ============================================================
# KG AI Builder — 环境变量配置
# ============================================================
# 使用方法:
#   1. 复制此文件为 .env
#   2. 填入您的 API Key
#   3. 启动服务: docker compose up -d
# ============================================================

# ==================== LLM API Keys ====================
# 至少配置一个即可使用

# 智谱AI (推荐国内用户，零门槛注册)
# 注册: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenAI
# 注册: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
# 注册: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini
# 注册: https://makersuite.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# 阿里云通义千问 (DashScope)
# 注册: https://help.aliyun.com/document_detail/2712195.html
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ==================== Neo4j 数据库配置 ====================
# Docker Compose 环境（默认连接同网络的 neo4j 服务）
NEO4J_AUTH=neo4j/password123
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# 本地开发环境（取消注释使用）
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_neo4j_password

# ==================== 应用配置（可选）====================
# 文本处理分块大小（字符数）
CHUNK_SIZE=2000

# 最小分块大小（字符数）
CHUNK_MIN_SIZE=500

# LLM 温度参数（0.0-1.0，越低越确定）
LLM_TEMPERATURE=0.1